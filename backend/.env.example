# Server Network Configuration
PORT=4000
CORS_ORIGIN=*

# NeonDB Cloud PostgreSQL Connection
# Format: postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require
# Replace with your NeonDB connection string from https://console.neon.tech
DATABASE_URL=postgresql://neondb_owner:npg_password@ep-sample-pool-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Optional Discrete Parameters (if connecting via parameters instead of URI)
PGHOST=ep-sample-pool-123456.us-east-2.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=your_neon_password
PGPORT=5432
PGSSLMODE=require
